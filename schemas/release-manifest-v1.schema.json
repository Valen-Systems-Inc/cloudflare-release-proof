{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://valensystemsinc.com/schemas/release-manifest-v1.schema.json",
  "title": "Cloudflare Release Proof Manifest v1",
  "$comment": "Well-formed Unicode, Unicode NFC normalization, Unicode code-point sorting, duplicate and cross-platform path collision detection, and aggregate byte limits require semantic validation in code.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "algorithm", "pathEncoding", "entries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "algorithm": { "const": "sha256" },
    "pathEncoding": { "const": "utf8-nfc" },
    "entries": {
      "type": "array",
      "maxItems": 10000,
      "items": { "$ref": "#/definitions/entry" }
    }
  },
  "definitions": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![A-Za-z]:)(?!.*\\\\)(?!.*[\\u0000-\\u001f\\u007f])(?!(?:\\.|\\.\\.)(?:/|$))(?!.*\\/(?:\\.|\\.\\.)(?:/|$))[^/]+(?:/[^/]+)*$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 68719476736
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
