{
  "name": "@valen-systems/cloudflare-release-proof",
  "version": "0.1.0",
  "description": "Deterministic local and public release verification for Cloudflare-served files.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": { "node": ">=22.13.0" },
  "bin": { "cf-release-proof": "src/cli.mjs" },
  "scripts": {
    "test": "node --test --test-reporter=spec",
    "lint": "eslint src test scripts",
    "typecheck": "tsc --project jsconfig.json",
    "build:portable": "node scripts/build-portable.mjs",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "22.20.1",
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "eslint": "10.10.0",
    "typescript": "7.0.2"
  }
}
